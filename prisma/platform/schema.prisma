generator client {
  provider = "prisma-client-js"
  output   = "../../apps/api/node_modules/@prisma-clients/platform"
}

datasource db {
  provider = "postgresql"
  url      = env("PLATFORM_DATABASE_URL")
}

enum TenantStatus {
  PROVISIONING
  ACTIVE
  PROVISIONING_FAILED
  SUSPENDED
}

model Tenant {
  id           String       @id @default(uuid())
  name         String
  slug         String       @unique
  databaseName String       @unique @map("database_name")
  databaseHost String       @map("database_host")
  databasePort Int          @map("database_port")
  status       TenantStatus @default(PROVISIONING)

  // Held only until provisioning finishes, so a failed provisioning attempt
  // can be retried without asking the caller to resubmit owner credentials.
  // Cleared once the tenant reaches ACTIVE.
  ownerEmail        String? @map("owner_email")
  ownerPasswordHash String? @map("owner_password_hash")

  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@map("tenants")
}
