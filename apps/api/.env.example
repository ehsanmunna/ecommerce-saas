# Platform DB (tenant registry)
# Port 55432 (not the default 5432) avoids clashing with a native Postgres
# install that may already be running on this machine - see docker-compose.yml.
PLATFORM_DATABASE_URL=postgresql://saas:saas_dev_password@localhost:55432/platform

# Tenant DB provisioning - every tenant database lives on this same server
# in Phase 1 (see design.md); only the database name differs per tenant.
TENANT_DB_HOST=localhost
TENANT_DB_PORT=55432
TENANT_DB_ADMIN_USER=saas
TENANT_DB_ADMIN_PASSWORD=saas_dev_password
# Database used to run CREATE DATABASE / DROP DATABASE against (must not be
# a tenant database itself). docker-compose creates "platform" as the default
# database, so use that unless your Postgres also has a "postgres" database.
TENANT_DB_MAINTENANCE_DATABASE=platform

# JWT
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL=15m
# Separate secret for storefront customer tokens, so a customer token can
# never verify as a staff token or vice versa (see phase-2-ecommerce design.md).
JWT_CUSTOMER_ACCESS_SECRET=dev-customer-access-secret-change-me

# Storefront checkout - flat shipping fee (no carrier-rate integration yet).
STOREFRONT_SHIPPING_FEE=5

# Tenant resolution
# Root domain used to parse "<slug>.<root>" from the request Host header.
APP_ROOT_DOMAIN=yoursaas.local

# CORS
ADMIN_APP_ORIGIN=http://localhost:3000
STOREFRONT_APP_ORIGIN=http://localhost:3002

# API docs (/api/docs, /api/docs-json) are served unless NODE_ENV=production.
# Set to true to force them on even under a production config.
# ENABLE_API_DOCS=true

# Tenant verification email (SMTP via nodemailer)
# Leave SMTP_HOST empty in dev to log verification links instead of sending.
# For local dev, use Mailhog (localhost:1025) or Mailtrap.
# SMTP_SECURE accepts true/1/yes/ssl (case-insensitive); port 465 always
# implies a secure (implicit TLS) connection even when this is false/unset.
# For Gmail use smtp.gmail.com:465 with SMTP_SECURE=true and a 16-character
# app password (Google Account > Security > App passwords), not your login
# password; the spaces Google displays can be kept or removed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Ecommerce SaaS <no-reply@localhost>
# Public admin URL used to build the /verify-email?token= link
ADMIN_APP_URL=http://localhost:3000
# Verification token lifetime in hours
VERIFICATION_TOKEN_TTL_HOURS=24

PORT=3001
