NEXT_PUBLIC_API_URL=http://localhost:3001

# Local dev has no wildcard DNS, so there is no subdomain to resolve a
# tenant from (see README's "no real wildcard DNS" note for apps/admin).
# In production, the storefront is reached at <slug>.<root-domain> and the
# backend resolves the tenant from the Host header - no client-side value
# is needed at all. Locally, this pins the whole dev server to one
# tenant's storefront, sent as the x-tenant-slug header on every request -
# change it (and restart) to browse a different tenant's dev storefront.
NEXT_PUBLIC_DEV_TENANT_SLUG=acme
